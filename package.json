{
  "name": "konductor-workflow",
  "version": "0.1.31",
  "description": "Konductor Workflow Installer and CLI",
  "keywords": [
    "ai",
    "agents",
    "workflow",
    "coding-assistant",
    "llm",
    "productivity",
    "second-brain",
    "cli"
  ],
  "bin": {
    "konductor-workflow": "blueprints/scripts/meet-konductor.sh",
    "konductor": "blueprints/scripts/meet-konductor.sh"
  },
  "files": [
    "VERSION",
    "blueprints/AGENTS.md",
    "blueprints/.gitignore",
    "blueprints/KONDUCTOR.md",
    "blueprints/KONDUCTOR_VERSION.json",
    "blueprints/KONDUCTOR_WORKFLOW.md",
    "blueprints/docs/CHECK_IN.md",
    "blueprints/memory/KONDUCTOR_ADR_HISTORY.md",
    "blueprints/memory/KONDUCTOR_MEMORY.md",
    "blueprints/memory/KONDUCTOR_VISION_ROADMAP.md",
    "blueprints/scripts/meet-konductor.sh"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "publish-from-npm": "npm publish",
    "prepublishOnly": "npm run verify:release",
    "release:patch": "npm version patch && npm run verify:release",
    "verify:release": "node scripts/verify-release.js",
    "version": "node scripts/sync-version.js && git add VERSION blueprints/KONDUCTOR_VERSION.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "mermaid": "^11.14.0"
  }
}
