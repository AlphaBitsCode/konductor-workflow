{
  "name": "konductor-housekeeping",
  "version": "1.0.0",
  "private": true,
  "description": "Konductor Framework housekeeping loop for repository maintenance",
  "main": "housekeeping.ts",
  "scripts": {
    "start": "tsx housekeeping.ts",
    "upgrade": "tsx upgrade-konductor.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && make-coverage-badge",
    "lint:md": "markdownlint-cli2 \"../../**/*.md\" \"#../../node_modules\" \"#../../**/node_modules\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "make-coverage-badge": "^1.2.0",
    "markdownlint-cli2": "^0.22.0",
    "tsx": "^4.19.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
